# Approved release defaults; all VITE_* values are public browser configuration.
# npm run build:online overrides VITE_SERVER_URL=auto for same-origin /world.
VITE_SERVER_URL=
VITE_ANALYTICS_TAG=
VITE_GAME_PUBLIC=1
VITE_COMPRESSED=1
VITE_DAY_CYCLE_PROGRESS=0.1
VITE_YEAR_CYCLE_PROGRESS=0.4
VITE_WHISPERS_COUNT=30
VITE_MUSIC=1
VITE_LOG=
VITE_PLAYER_SPAWN=landing
